{
  "name": "flowplus-flow-mcp",
  "version": "0.2.0",
  "description": "MCP server for building FlowPlus automation flows from natural language — works with Claude Code, Codex, and any MCP client",
  "type": "module",
  "bin": {
    "flowplus-flow-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasterteamSA/flowplus-flow-mcp.git"
  },
  "homepage": "https://github.com/MasterteamSA/flowplus-flow-mcp#readme",
  "bugs": {
    "url": "https://github.com/MasterteamSA/flowplus-flow-mcp/issues"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "flowplus",
    "workflow",
    "automation",
    "bpm",
    "claude",
    "ai"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Masterteam"
}
